@@ -588,6 +588,18 @@ struct std::allocator_traits<Firebird::PoolAllocator<TAlloc>>
 
 	using is_always_equal = typename Alloc::is_always_equal;
 
+	// Recent libc++ (Xcode 27, __type_traits/is_replaceable.h) reads these
+	// members of allocator_traits directly. The values are what the standard
+	// allocator_traits gives an allocator without its own: false_type and a copy.
+	using propagate_on_container_copy_assignment = std::false_type;
+	using propagate_on_container_move_assignment = std::false_type;
+	using propagate_on_container_swap = std::false_type;
+
+	static constexpr Alloc select_on_container_copy_construction(const Alloc& alloc)
+	{
+		return alloc;
+	}
+
 	template <typename T>
 	using rebind_alloc = typename Alloc::template rebind<T>::other;
 
